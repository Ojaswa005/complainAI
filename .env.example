# ==========================================
# Complain AI — Environment Configuration
# ==========================================

# Database Configuration
# Default is SQLite for instant zero-config local running:
DATABASE_URL=sqlite:///./complain_ai.db
# For PostgreSQL (e.g. Supabase Postgres or AWS RDS):
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@db.xyz.supabase.co:5432/postgres

# Supabase Auth & Storage (Optional for live Supabase integration)
# When left empty, Complain AI runs in local standalone mode with built-in instant demo accounts
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-backend-verification

# Backend Security
JWT_SECRET=super-secure-local-jwt-secret-key-321

# GenAI Feature: AI Rant Assistant
# Supports 'gemini', 'openai', or built-in smart dynamic linguistic engine
AI_PROVIDER=gemini
AI_MODEL_NAME=gemini-1.5-flash
GEMINI_API_KEY=
# OPENAI_API_KEY=

# Frontend API URL
VITE_API_URL=http://127.0.0.1:8000/api/v1
